{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "transcritor-web",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:Path = [Environment]::GetEnvironmentVariable('Path','User') + ';' + [Environment]::GetEnvironmentVariable('Path','Machine'); .\\venv\\Scripts\\python.exe manage.py runserver 8000"
      ],
      "port": 8000
    }
  ]
}
