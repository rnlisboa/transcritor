# Copie este arquivo para ".env" e ajuste os valores.
# Variáveis definidas no ambiente do sistema têm prioridade sobre o .env.

# --- Django ---
DEBUG=True
SECRET_KEY=change-me
# Hosts separados por vírgula. Ex.: seuusuario.pythonanywhere.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Opcional. Ex.: https://seuusuario.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=

# --- Transcrição (Vosk) ---
# Pasta do modelo descompactado (padrão: models/vosk-model-small-pt-0.3)
VOSK_MODEL_PATH=
# Segundos de processamento por requisição (cada pedaço para numa pausa da fala)
TRANSCRIBE_CHUNK_SECONDS=10

# --- Upload ---
MAX_UPLOAD_SIZE_MB=200

# --- FFmpeg ---
FFMPEG_BINARY=ffmpeg

# --- Opcionais ---
# Cookies só por HTTPS. Padrão: ativo quando DEBUG=False.
# Use False apenas para testar DEBUG=False localmente via http://.
# SECURE_COOKIES=True
# Nível de log: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
# Pasta dos arquivos enviados (padrão: <projeto>/media)
# MEDIA_ROOT=
